    "@girs/glib-2.0": "^4.1.0",
    "@girs/gobject-2.0": "^4.1.0",
    "@girs/gtk-4.0": "^4.1.0",
    "@girs/gnome-shell": "^50.0.4",
    "@types/node": "^24.0.0",
    "eslint": "^9.30.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.4"
